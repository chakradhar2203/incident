# ============================================================
# RCA Assistant - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to source control

# --- ServiceNow Configuration ---
SERVICENOW_INSTANCE_URL=https://dev411616.service-now.com
SERVICENOW_USERNAME=incident.rca.integration
SERVICENOW_PASSWORD=your_servicenow_password_here

# --- Claude API Configuration (Anthropic) ---
CLAUDE_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- Firebase Configuration ---
# Path to your Firebase service account JSON key file
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
FIREBASE_PROJECT_ID=rca-assistant-in

# --- Application Settings ---
# Enable ServiceNow write-back (true/false) - DISABLED by default
SERVICENOW_WRITEBACK_ENABLED=true

# Analysis mode: "local" or "ai"
ANALYSIS_MODE=ai

# App host/port
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Optional: Recurring Scheduler ---
SCHEDULER_INTERVAL_MINUTES=2

